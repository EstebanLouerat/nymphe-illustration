{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "env": { "BROWSER": "none" },
      "port": 3000
    },
    {
      "name": "preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "preview", "--port", "4173", "--strictPort", "--no-open"],
      "env": { "BROWSER": "none" },
      "port": 4173
    }
  ]
}
